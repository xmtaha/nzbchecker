#!/bin/sh
# NZB Checker AppImage başlatıcı — sistemdeki python3 + tkinter kullanılır
HERE="$(dirname "$(readlink -f "$0")")"
for py in "$NZB_PYTHON" /usr/bin/python3 /usr/local/bin/python3 python3; do
    [ -n "$py" ] || continue
    if "$py" -c 'import tkinter' >/dev/null 2>&1; then
        exec "$py" "$HERE/usr/src/nzb_gui.py" "$@"
    fi
done
msg="python3 veya tkinter bulunamadı.
Kurulum: sudo apt install python3-tk (Fedora: sudo dnf install python3-tkinter)"
echo "$msg" >&2
command -v zenity >/dev/null 2>&1 && zenity --error --text "$msg"
exit 1
