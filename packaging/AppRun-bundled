#!/bin/sh
# NZB Checker AppImage başlatıcı — Python ve Tk paket içinde gömülü
HERE="$(dirname "$(readlink -f "$0")")"
export PYTHONPATH="$HERE/usr/src${PYTHONPATH:+:$PYTHONPATH}"
export LD_LIBRARY_PATH="$HERE/usr/python:$LD_LIBRARY_PATH"
export TCL_LIBRARY="$HERE/usr/python/lib/tcl9.0"
export TK_LIBRARY="$HERE/usr/python/lib/tk9.0"
exec "$HERE/usr/python/python3" -m nzb_checker "$@"
